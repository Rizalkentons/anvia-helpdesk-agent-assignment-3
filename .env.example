OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://gateway.devscale.id/v1

# Chat model used by the agent and by the memory summarizer.
MODEL_ID=gpt-5.6-luna

# Local PostgreSQL and Adminer (docker compose). Ports are configurable so this
# project can run next to other copies of the class repository.
DB_PORT=5545
ADMINER_PORT=8086
DATABASE_URL="postgresql://anvia:anvia@localhost:5545/anvia"

# Automatic memory compaction, in estimated tokens. The trigger fires when the
# model-facing projection plus the new prompt exceeds MEMORY_COMPACTION_AFTER_TOKENS;
# the newest turns inside MEMORY_COMPACTION_RECENT_TOKENS stay verbatim.
# Set AFTER_TOKENS low (for example 300) to watch compaction during a short demo.
MEMORY_COMPACTION_AFTER_TOKENS=8000
MEMORY_COMPACTION_RECENT_TOKENS=2000

# Demo identity and storage for the ticket tools.
DEMO_USER_ID=user_456
TICKETS_FILE=data/tickets.json

# Anvia Studio UI.
STUDIO_PORT=4021
